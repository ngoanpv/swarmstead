{
  "name": "swarmstead",
  "version": "0.3.4",
  "description": "Watch your Claude Code (and Codex) agents live as pixel characters: handoffs, cost, loops, stuck permissions, context pressure — and familiars that evolve with good habits.",
  "author": "ngoanpv (https://github.com/ngoanpv)",
  "homepage": "https://github.com/ngoanpv/swarmstead#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngoanpv/swarmstead.git"
  },
  "bugs": {
    "url": "https://github.com/ngoanpv/swarmstead/issues"
  },
  "type": "module",
  "bin": {
    "swarmstead": "bin/swarmstead.js"
  },
  "files": [
    "bin",
    "core",
    "server",
    "web",
    "plugin",
    ".claude-plugin",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/swarmstead.js start",
    "dev": "node --watch-path=server --watch-path=core --watch-path=bin bin/swarmstead.js start",
    "test": "node --test",
    "build:demo": "node scripts/build-demo.js",
    "gen:hooks": "node scripts/gen-plugin-hooks.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "observability",
    "pixel-art",
    "multi-agent",
    "token-usage",
    "cost-tracking",
    "hooks",
    "gamification"
  ],
  "license": "MIT",
  "devDependencies": {}
}
