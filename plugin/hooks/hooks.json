{
  "description": "Forward Claude Code lifecycle events to the local Swarmstead daemon (http://127.0.0.1:4317). The forwarders are async and never print. On SessionStart one quick synchronous hook starts the daemon if needed and shows the village address.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swarmstead-hook.mjs\" claude",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swarmstead-up.mjs\" --say",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swarmstead-hook.mjs\" claude",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
